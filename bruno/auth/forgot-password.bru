meta {
  name: Forgot Password
  description: Initiate password reset by sending reset email
}

method POST
url {{base_url}}/auth/forgot-password

headers {
  Content-Type: application/json
}

body {
  {
    "email": "{{admin_email}}"
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
}
