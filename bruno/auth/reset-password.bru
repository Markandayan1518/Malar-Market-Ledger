meta {
  name: Reset Password
  description: Reset password using token received from forgot password email
}

method POST
url {{base_url}}/auth/reset-password

headers {
  Content-Type: application/json
}

body {
  {
    "token": "reset-token-from-email",
    "new_password": "newSecurePassword123"
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
}
