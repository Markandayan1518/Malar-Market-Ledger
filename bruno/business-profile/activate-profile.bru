meta {
  name: Activate Business Profile
  description: Activate a business profile (deactivates others)
}

auth: bearer

method POST
url {{base_url}}/business-profile/{{profile_id}}/activate

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
