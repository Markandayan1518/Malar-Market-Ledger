meta {
  name: Delete Business Profile
  description: Delete a business profile (Admin only, cannot delete active)
}

auth: bearer

method DELETE
url {{base_url}}/business-profile/{{profile_id}}

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
