meta {
  name: List Business Profiles
  description: List all business profiles (Admin only)
}

auth: bearer

method GET
url {{base_url}}/business-profile/all

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
