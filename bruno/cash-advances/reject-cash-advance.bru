meta {
  name: Reject Cash Advance
  description: Reject a pending cash advance request
}

auth: bearer

method POST
url {{base_url}}/cash-advances/{{advance_id}}/reject

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body {
  {
    "rejection_reason": "Insufficient balance in farmer account. Please settle outstanding advances first."
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
  bru.assertion(expect(response).to.have.property('data'));
  bru.assertion(expect(response).to.have.property('message'));
}
