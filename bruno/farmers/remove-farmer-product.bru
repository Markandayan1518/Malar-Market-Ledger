meta {
  name: Remove Farmer Product
  description: Remove a flower type from a farmer's profile (soft delete)
}

auth: bearer

method DELETE
url {{base_url}}/farmers/{{farmer_id}}/products/{{product_id}}

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
}
