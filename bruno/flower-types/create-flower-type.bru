meta {
  name: Create Flower Type
  description: Create a new flower type (Staff/Admin only)
}

auth: bearer

method POST
url {{base_url}}/flower-types/?name=Jasmine&name_ta=%E0%AE%AE%E0%AE%B2%E0%AF%8D%E0%AE%B2%E0%AE%BF%E0%AE%95%E0%AF%88&unit=kg

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(201));
  bru.assertion(expect(response).to.have.property('success'));
  if (response.data && response.data.id) {
    bru.setEnvVar('flower_type_id', response.data.id);
  }
}
