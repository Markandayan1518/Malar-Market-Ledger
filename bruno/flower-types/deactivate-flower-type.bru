meta {
  name: Deactivate Flower Type
  description: Deactivate a flower type (Staff/Admin only)
}

auth: bearer

method PATCH
url {{base_url}}/flower-types/{{flower_type_id}}/deactivate

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
