meta {
  name: List Active Flower Types
  description: List all active flower types for dropdowns
}

auth: bearer

method GET
url {{base_url}}/flower-types/active

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
