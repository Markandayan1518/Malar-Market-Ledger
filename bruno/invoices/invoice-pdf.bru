meta {
  name: Invoice PDF
  description: Generate PDF for an invoice (English or Tamil)
}

auth: bearer

method GET
url {{base_url}}/invoices/{{invoice_id}}/pdf?language=en

headers {
  Accept: application/pdf
  Authorization: Bearer {{access_token}}
}

script:post-response {
  bru.assertion(expect(res.getStatus()).to.equal(200));
}
