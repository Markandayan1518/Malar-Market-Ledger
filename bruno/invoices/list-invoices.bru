meta {
  name: List Invoices
  description: List invoices with filtering and pagination (Staff/Admin only)
}

auth: bearer

method GET
url {{base_url}}/invoices/?page=1&page_size=20

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
