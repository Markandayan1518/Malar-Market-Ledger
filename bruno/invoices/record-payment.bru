meta {
  name: Record Payment
  description: Record a payment for an invoice
}

auth: bearer

method POST
url {{base_url}}/invoices/{{invoice_id}}/payment

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body {
  {
    "amount": 5000.00,
    "notes": "Partial payment received via UPI"
  }
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response).to.have.property('balance_due'));
}
