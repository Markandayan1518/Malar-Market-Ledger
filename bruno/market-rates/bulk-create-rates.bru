meta {
  name: Bulk Create Market Rates
  description: Create multiple market rates at once (Staff/Admin only)
}

auth: bearer

method POST
url {{base_url}}/market-rates/bulk

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body {
  [
    {
      "flower_type_id": "{{flower_type_id}}",
      "time_slot_id": "{{time_slot_id}}",
      "rate_per_unit": 150.00,
      "effective_date": "2026-02-15"
    },
    {
      "flower_type_id": "{{flower_type_id}}",
      "time_slot_id": "{{time_slot_id}}",
      "rate_per_unit": 160.00,
      "effective_date": "2026-02-16"
    }
  ]
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(201));
  bru.assertion(expect(response).to.have.property('success'));
}
