meta {
  name: Get Current Rate
  description: Get current applicable rate for a flower type and time
}

auth: bearer

method GET
url {{base_url}}/market-rates/current

headers {
  Authorization: Bearer {{access_token}}
}

query {
  flower_type_id: {{flower_type_id}}
  entry_time: 05:30:00
}

script:post-response {
  const response = res.getBody();
  
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
  bru.assertion(expect(response).to.have.property('data'));
}
