meta {
  name: Monthly Report
  description: Generate master monthly report for all farmers (PDF/Excel)
}

auth: bearer

method GET
url {{base_url}}/reports/monthly-report/2/2026?format=excel

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  bru.assertion(expect(res.getStatus()).to.equal(200));
}
