meta {
  name: Settlement Report
  description: Generate settlement report PDF for a specific settlement
}

auth: bearer

method GET
url {{base_url}}/reports/settlement-report/{{settlement_id}}?format=pdf

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  bru.assertion(expect(res.getStatus()).to.equal(200));
}
