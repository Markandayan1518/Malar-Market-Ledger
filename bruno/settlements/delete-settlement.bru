meta {
  name: Delete Settlement
  description: Soft delete a settlement (only draft settlements)
}

auth: bearer

method DELETE
url {{base_url}}/settlements/{{settlement_id}}

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
