meta {
  name: Delete Setting
  description: Delete a system setting by key (Admin only)
}

auth: bearer

method DELETE
url {{base_url}}/system-settings/test_key

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
