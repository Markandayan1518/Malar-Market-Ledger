meta {
  name: Get Business Profile Settings
  description: Get business profile from system settings
}

auth: bearer

method GET
url {{base_url}}/system-settings/business/profile

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
