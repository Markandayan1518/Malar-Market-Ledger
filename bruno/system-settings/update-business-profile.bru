meta {
  name: Update Business Profile Settings
  description: Update business profile in system settings (Staff/Admin only)
}

auth: bearer

method PUT
url {{base_url}}/system-settings/business/profile?business_name=Malar%20Flower%20Market&business_address=123%20Market%20Road%2C%20Dindigul&business_phone=%2B919876543210&currency_symbol=%E2%82%B9

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
