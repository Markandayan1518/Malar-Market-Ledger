meta {
  name: Update System Setting
  description: Update a specific system configuration setting
}

auth: bearer

method PUT
url {{base_url}}/system-settings/default_commission_pct

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body {
  {
    "value": "12.50",
    "description": "Default commission percentage for all farmers"
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
  bru.assertion(expect(response).to.have.property('data'));
  bru.assertion(expect(response).to.have.property('message'));
}
