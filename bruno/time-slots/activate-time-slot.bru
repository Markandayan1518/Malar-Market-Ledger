meta {
  name: Activate Time Slot
  description: Activate a time slot (Staff/Admin only)
}

auth: bearer

method PATCH
url {{base_url}}/time-slots/{{time_slot_id}}/activate

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
