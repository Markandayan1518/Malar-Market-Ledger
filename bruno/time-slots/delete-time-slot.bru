meta {
  name: Delete Time Slot
  description: Soft delete a time slot (Admin only)
}

auth: bearer

method DELETE
url {{base_url}}/time-slots/{{time_slot_id}}

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
