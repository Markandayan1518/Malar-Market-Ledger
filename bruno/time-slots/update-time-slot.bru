meta {
  name: Update Time Slot
  description: Update a time slot (Staff/Admin only)
}

auth: bearer

method PUT
url {{base_url}}/time-slots/{{time_slot_id}}?name=Morning%20Updated&start_time=05:30&end_time=10:30

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
}
