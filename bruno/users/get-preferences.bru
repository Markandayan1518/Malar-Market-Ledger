meta {
  name: Get Preferences
  description: Get current user preferences (language, theme, notifications)
}

auth: bearer

method GET
url {{base_url}}/users/me/preferences

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.data).to.have.property('language'));
  bru.assertion(expect(response.data).to.have.property('theme'));
}
