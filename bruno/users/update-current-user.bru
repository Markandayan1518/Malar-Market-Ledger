meta {
  name: Update Current User
  description: Update current user profile (name, language, theme)
}

auth: bearer

method PUT
url {{base_url}}/users/me?full_name=Updated Name&language_preference=ta&theme_preference=warm

headers {
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const response = res.getBody();
  bru.assertion(expect(res.getStatus()).to.equal(200));
  bru.assertion(expect(response).to.have.property('success'));
  bru.assertion(expect(response.success).to.equal(true));
}
